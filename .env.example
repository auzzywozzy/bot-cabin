# Copy to .env (git-ignored) for the helper scripts, and set the same values in your host's
# environment variables (for example Vercel > Project > Settings > Environment Variables).

# Secret used to authorise POST /api/status and POST /api/board. Use at least 32 random
# characters, for example: openssl rand -hex 32
# If this is unset or shorter than 32 characters, the write endpoints refuse every request.
STATUS_WRITE_TOKEN=

# Public URL of your deployed site, no trailing slash. Used by scripts/set-status.sh and
# scripts/push-board.sh to reach your API.
SITE_URL=https://your-site.example.com

# Vercel Blob read/write token. Vercel adds this for you when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Time zone for the clock, the "Today" board and "this week" counts (IANA name, default UTC).
# TIMEZONE is read by the scripts and the API. VITE_TIMEZONE is read by the browser build.
TIMEZONE=UTC
VITE_TIMEZONE=UTC
# Where the sun is, used for the live sun position (defaults: 47, 0).
VITE_LAT=47
VITE_LON=0
